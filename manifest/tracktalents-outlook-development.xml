<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="MailApp">
  <Id>0690e3a2-3e86-4f30-bd1b-4a0d60470bb5</Id>
  <Version>1.0.8.0</Version>
  <ProviderName>TrackTalents</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="TrackTalents Outlook Dev" />
  <Description DefaultValue="Development and testing version of the TrackTalents Outlook add-in." />
  <IconUrl DefaultValue="https://localhost:3201/assets/icon-64.png" />
  <HighResolutionIconUrl DefaultValue="https://localhost:3201/assets/icon-80.png" />
  <SupportUrl DefaultValue="https://localhost:3201/taskpane.html?v=dev" />
  <AppDomains>
    <AppDomain>https://localhost:3201</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.8" />
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://localhost:3201/taskpane.html?v=dev" />
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://localhost:3201/taskpane.html?v=dev" />
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit" />
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides
    xmlns="http://schemas.microsoft.com/office/mailappversionoverrides"
    xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.8">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url" />
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="TrackTalents.ReadGroup">
                <Label resid="GroupLabel" />
                <Control xsi:type="Button" id="TrackTalents.ReadShowPane">
                  <Label resid="ShowPaneLabel" />
                  <Supertip>
                    <Title resid="ShowPaneLabel" />
                    <Description resid="ShowPaneDescription" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16" />
                    <bt:Image size="32" resid="Icon.32" />
                    <bt:Image size="80" resid="Icon.80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="TrackTalents.ComposeGroup">
                <Label resid="GroupLabel" />
                <Control xsi:type="Button" id="TrackTalents.ComposeShowPane">
                  <Label resid="ShowPaneLabel" />
                  <Supertip>
                    <Title resid="ShowPaneLabel" />
                    <Description resid="ShowPaneDescription" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16" />
                    <bt:Image size="32" resid="Icon.32" />
                    <bt:Image size="80" resid="Icon.80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://localhost:3201/assets/icon-16.png" />
        <bt:Image id="Icon.32" DefaultValue="https://localhost:3201/assets/icon-32.png" />
        <bt:Image id="Icon.80" DefaultValue="https://localhost:3201/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://localhost:3201/taskpane.html?v=dev" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://localhost:3201/taskpane.html?v=dev" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="TrackTalents Dev" />
        <bt:String id="ShowPaneLabel" DefaultValue="Open TrackTalents Dev" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="ShowPaneDescription" DefaultValue="Open the development version of the TrackTalents Outlook add-in." />
      </bt:LongStrings>
    </Resources>
    <VersionOverrides
      xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1"
      xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.8">
          <bt:Set Name="Mailbox" />
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url" />
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="TrackTalents.ReadGroup">
                  <Label resid="GroupLabel" />
                  <Control xsi:type="Button" id="TrackTalents.ReadShowPane">
                    <Label resid="ShowPaneLabel" />
                    <Supertip>
                      <Title resid="ShowPaneLabel" />
                      <Description resid="ShowPaneDescription" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16" />
                      <bt:Image size="32" resid="Icon.32" />
                      <bt:Image size="80" resid="Icon.80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url" />
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="TrackTalents.ComposeGroup">
                  <Label resid="GroupLabel" />
                  <Control xsi:type="Button" id="TrackTalents.ComposeShowPane">
                    <Label resid="ShowPaneLabel" />
                    <Supertip>
                      <Title resid="ShowPaneLabel" />
                      <Description resid="ShowPaneDescription" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16" />
                      <bt:Image size="32" resid="Icon.32" />
                      <bt:Image size="80" resid="Icon.80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url" />
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16" DefaultValue="https://localhost:3201/assets/icon-16.png" />
          <bt:Image id="Icon.32" DefaultValue="https://localhost:3201/assets/icon-32.png" />
          <bt:Image id="Icon.80" DefaultValue="https://localhost:3201/assets/icon-80.png" />
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Commands.Url" DefaultValue="https://localhost:3201/taskpane.html?v=dev" />
          <bt:Url id="Taskpane.Url" DefaultValue="https://localhost:3201/taskpane.html?v=dev" />
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="TrackTalents Dev" />
          <bt:String id="ShowPaneLabel" DefaultValue="Open TrackTalents Dev" />
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="ShowPaneDescription" DefaultValue="Open the development version of the TrackTalents Outlook add-in." />
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
